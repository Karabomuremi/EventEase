@model EventEase.Models.Booking
@{
    ViewData["Title"] = "Create Booking";
}

<div class="container mt-4">
    <h2>📋 New Booking</h2>
    <p class="text-muted">Complete the form below to create a new venue booking.</p>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="EventId" class="form-label">Event</label>
            <select asp-for="EventId" class="form-select"
                    asp-items="@(ViewData["EventId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)">
                <option value="">-- Select Event --</option>
            </select>
            <span asp-validation-for="EventId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VenueId" class="form-label">Venue</label>
            <select asp-for="VenueId" class="form-select"
                    asp-items="@(ViewData["VenueId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)">
                <option value="">-- Select Venue --</option>
            </select>
            <span asp-validation-for="VenueId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BookingDate" class="form-label"></label>
            <input asp-for="BookingDate" class="form-control" type="date" />
            <span asp-validation-for="BookingDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <input asp-for="Status" class="form-control" value="Confirmed" />
        </div>

        <button type="submit" class="btn btn-success">Create Booking</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>