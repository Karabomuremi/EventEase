@model IEnumerable<EventEase.Models.Booking>
@{
    ViewData["Title"] = "EventEase - Booking Search";
}

<div class="container mt-4">
    <h2>🗓️ EventEase - Venue Booking Search System</h2>
    <p class="text-muted">Search and filter bookings by event type, date range, and venue availability.</p>

    <form method="get" asp-action="Search">
        <div class="row g-3 mb-4 p-3 bg-light rounded border">

            <div class="col-md-3">
                <label class="form-label fw-bold">Search</label>
                <input type="text" name="searchString" class="form-control"
                       value="@Context.Request.Query["searchString"]"
                       placeholder="Event name or Booking ID" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Event Type</label>
                <select name="eventTypeId" class="form-select">
                    <option value="">-- All Types --</option>
                    @foreach (var item in ViewBag.EventTypes)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold">From Date</label>
                <input type="date" name="startDate" class="form-control"
                       value="@Context.Request.Query["startDate"]" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold">To Date</label>
                <input type="date" name="endDate" class="form-control"
                       value="@Context.Request.Query["endDate"]" />
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">🔍 Search</button>
                <a href="/Bookings/Search" class="btn btn-outline-secondary w-100">Clear</a>
            </div>

        </div>
    </form>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">No bookings found. Try adjusting your filters.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Booking ID</th>
                    <th>Event Name</th>
                    <th>Event Type</th>
                    <th>Venue</th>
                    <th>Booking Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.Event?.EventName</td>
                        <td>@booking.Event?.EventType?.Name</td>
                        <td>@booking.Venue?.VenueName</td>
                        <td>@booking.BookingDate.ToShortDateString()</td>
                        <td>
                            <span class="badge bg-success">@booking.Status</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@booking.BookingId"
                               class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@booking.BookingId"
                               class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@booking.BookingId"
                               class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a asp-action="Create" class="btn btn-success">+ New Booking</a>
    </div>
</div>
