@model EventEase.Models.Venue
@{
    ViewData["Title"] = "Venue Details";
}

<div class="container mt-4">
    <h2>🏟️ Venue Details</h2>

    <div class="card" style="max-width: 600px;">
        <div class="card-body">
            <h5 class="card-title">@Model.VenueName</h5>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Capacity:</strong> @Model.Capacity</p>
            @if (Model.ImageUrl != null)
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded" />
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.VenueId"
           class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>