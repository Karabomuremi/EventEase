@model EventEase.Models.Venue
@{
    ViewData["Title"] = "Delete Venue";
}

<div class="container mt-4">
    <h2>🗑️ Delete Venue</h2>

    <div class="alert alert-danger">
        Are you sure you want to delete <strong>@Model.VenueName</strong>?
    </div>

    <div class="card" style="max-width: 500px;">
        <div class="card-body">
            <p><strong>Venue Name:</strong> @Model.VenueName</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Capacity:</strong> @Model.Capacity</p>
        </div>
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="VenueId" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>